# Copy this file to `.env.local` for `npm run dev`.
# `.env.local` is gitignored via the `*.local` rule in .gitignore.
#
# Point at the Worker URL. For local dev, run `cd worker && npx wrangler dev`
# in another terminal — wrangler serves the Worker at 127.0.0.1:8787 by default.
#
# For production builds (GitHub Pages), set `VITE_WORKER_URL` as a repository
# variable in GitHub → Settings → Secrets and variables → Actions → Variables,
# then have the deploy workflow inject it at build time.
VITE_WORKER_URL=http://127.0.0.1:8787
